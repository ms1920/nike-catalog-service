# Copy to .env and edit. `.env` is gitignored; this template is not.
#
# Every value here has a working default, so the app runs with no .env at all.
# That is deliberate: the repository has to be handed to a reviewer who will clone
# and run it without provisioning anything.

# Passphrase the datastore encryption key is derived from.
#
# Unset, a committed default is used — which means the repo contains both the
# ciphertext and the key, so the encryption gives tamper detection and opacity but
# NOT confidentiality against anyone who can read the repo. Set this (and keep it
# out of version control) and the committed data file becomes genuinely
# undecryptable without it. The server logs a warning while the default is in use.
# DATA_KEY=

# Where the encrypted datastore lives.
# DATA_FILE=data/store.enc.json

# API port.
# PORT=3000

# When set, catalog writes require `x-api-key: <value>` — or an admin session.
# Left unset, catalog writes are open, which is what makes local exploration easy.
# API_KEY=

# Paging defaults. `MAX_PAGE_SIZE` is a hard ceiling; larger requests are clamped
# rather than rejected, so a client cannot use the API against itself.
# DEFAULT_PAGE_SIZE=20
# MAX_PAGE_SIZE=100
